{
  "name": "kasar",
  "version": "0.1.0",
  "description": "A shelf of small browser games, each one standing on its own.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "manifest": "node --disable-warning=ExperimentalWarning --experimental-strip-types tools/manifest.ts",
    "build:shell": "tsc -p tsconfig.shell.json",
    "build:games": "node --disable-warning=ExperimentalWarning --experimental-strip-types tools/build-games.ts",
    "build": "npm run manifest && npm run build:shell && npm run build:games",
    "stage": "node --disable-warning=ExperimentalWarning --experimental-strip-types tools/stage.ts",
    "serve": "node --disable-warning=ExperimentalWarning --experimental-strip-types tools/serve.ts",
    "play": "npm run build && npm run serve",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
